<section class="section">
  <div class="page-width">
    <div class="section__header">
      <h2 class="section__title">{{ section.settings.title | default: "Featured Collection" }}</h2>
      {% if section.settings.show_view_all and section.settings.collection != blank %}
        <a href="{{ collections[section.settings.collection].url }}" class="button button--secondary">عرض الكل</a>
      {% endif %}
    </div>
    {% assign coll = collections[section.settings.collection] %}
    {% if coll == blank %}{% assign coll = collections.all %}{% endif %}
    <div class="grid" style="--cols:{{ section.settings.columns_desktop }}">
      {% for product in coll.products limit: section.settings.products_to_show %}
        {% render 'product-card', product: product %}
      {% else %}
        {% for i in (1..4) %}
          <div class="card">
            <div class="card__media"><div style="width:100%;height:100%;background:#1a1a1a;display:grid;place-items:center;opacity:.3">Product {{ i }}</div></div>
            <div class="card__info"><div class="card__title">Product placeholder — منتج تجريبي</div><div class="card__price">599 EGP</div></div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "BEST SELLERS" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Columns Desktop", "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show View All", "default": true }
  ],
  "presets": [{ "name": "Featured Collection" }]
}
{% endschema %}
