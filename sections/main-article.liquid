<div class="page-width"><div class="section"><h1 class="section__title">{{ article.title }}</h1><div style="margin-top:20px;opacity:.8;line-height:1.8">{{ article.content }}</div></div></div>
{% schema %}{ "name": "Article", "blocks": [{ "type": "featured_image", "name": "Image", "limit": 1 }, { "type": "title", "name": "Title", "limit": 1 }, { "type": "content", "name": "Content", "limit": 1 }, { "type": "share", "name": "Share", "limit": 1 }] }{% endschema %}
