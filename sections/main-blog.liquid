<div class="page-width"><div class="section"><h1 class="section__title">{{ blog.title }}</h1><div class="grid" style="margin-top:24px">{% for article in blog.articles %}<a href="{{ article.url }}" class="card"><div class="card__media">{% if article.image %}{{ article.image | image_url: width: 400 | image_tag }}{% endif %}</div><div class="card__info"><div class="card__title">{{ article.title }}</div><div style="opacity:.5;font-size:12px;margin-top:6px">{{ article.published_at | date: "%d/%m/%Y" }}</div></div></a>{% endfor %}</div></div></div>
{% schema %}{ "name": "Blog", "settings": [{ "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "grid", "label": "Grid" }, { "value": "collage", "label": "Collage" }], "default": "grid" }, { "type": "checkbox", "id": "show_image", "label": "Show Image", "default": true }, { "type": "checkbox", "id": "show_date", "label": "Show Date", "default": true }, { "type": "checkbox", "id": "show_author", "label": "Show Author", "default": false }] }{% endschema %}
