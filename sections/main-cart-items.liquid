<div class="page-width">
  <h1 class="section__title" style="margin:32px 0">سلة التسوق</h1>
  {% if cart.item_count == 0 %}
    <p style="text-align:center;opacity:.6;padding:60px 0">سلة التسوق فارغة — <a href="{{ routes.all_products_collection_url }}" style="color:var(--color-accent);text-decoration:underline">تسوق الآن</a></p>
  {% else %}
    <table class="cart-table">
      <thead><tr><th>Product</th><th>Quantity</th><th>Total</th></tr></thead>
      <tbody>
        {% for item in cart.items %}
          <tr>
            <td><div style="display:flex;gap:12px;align-items:center"><img src="{{ item.image | image_url: width: 80 }}" width="60" style="border-radius:8px"><div><div style="font-weight:700">{{ item.product.title }}</div><div style="opacity:.6;font-size:12px">{{ item.variant.title }}</div></div></div></td>
            <td><div class="qty"><button data-dir="minus">−</button><input value="{{ item.quantity }}"><button data-dir="plus">+</button></div></td>
            <td style="font-weight:800">{{ item.final_line_price | money }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}
</div>
{% schema %}{ "name": "Cart Items", "settings": [{ "type": "checkbox", "id": "show_vendor", "label": "Show Vendor", "default": false }] }{% endschema %}
