<div class="page-width"><div class="section"><h1 class="section__title" style="text-align:center">{{ section.settings.title }}</h1><div class="grid" style="margin-top:24px">{% for collection in collections %}<a href="{{ collection.url }}" class="card"><div class="card__media">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 400 | image_tag }}{% endif %}</div><div class="card__info"><div class="card__title">{{ collection.title }}</div></div></a>{% endfor %}</div></div></div>
{% schema %}{ "name": "List Collections", "settings": [{ "type": "text", "id": "title", "label": "Title", "default": "Collections" }, { "type": "select", "id": "sort", "label": "Sort", "options": [{ "value": "alphabetical", "label": "Alphabetical" }], "default": "alphabetical" }, { "type": "select", "id": "image_ratio", "label": "Ratio", "options": [{ "value": "adapt", "label": "Adapt" }], "default": "adapt" }, { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "default": 3, "label": "Columns" }] }{% endschema %}
