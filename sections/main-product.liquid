<section class="section">
  <div class="page-width">
    <div class="product">
      <div class="product__media">
        {% if product.featured_media %}
          {{ product.featured_media | image_url: width: 800 | image_tag }}
        {% else %}
          <div style="width:100%;height:100%;display:grid;place-items:center;background:#1a1a1a;color:#555">No Image</div>
        {% endif %}
      </div>
      <div class="product__info">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'title' %}<h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>
            {% when 'price' %}<div class="product__price" {{ block.shopify_attributes }}>{{ product.price | money }}</div>
            {% when 'variant_picker' %}
              <div class="variant-picker" {{ block.shopify_attributes }}>
                {% unless product.has_only_default_variant %}
                  {% for option in product.options_with_values %}
                    <div>
                      <div class="variant-picker__label">{{ option.name }}</div>
                      <div class="variant-picker__options">
                        {% for value in option.values %}
                          <button class="variant-picker__btn {% if option.selected_value == value %}is-active{% endif %}">{{ value }}</button>
                        {% endfor %}
                      </div>
                    </div>
                  {% endfor %}
                {% endunless %}
              </div>
            {% when 'quantity_selector' %}
              <div class="qty" {{ block.shopify_attributes }}>
                <button data-dir="minus">−</button><input type="number" value="1" min="1"><button data-dir="plus">+</button>
              </div>
            {% when 'buy_buttons' %}
              <div {{ block.shopify_attributes }} style="margin:20px 0;display:grid;gap:10px">
                <button type="submit" name="add" class="button" style="width:100%;padding:16px">{{ 'products.product.add_to_cart' | t }}</button>
                {% if block.settings.show_dynamic_checkout %}{{ form | payment_button }}{% endif %}
              </div>
            {% when 'description' %}<div class="product__desc" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {% when 'share' %}<div style="opacity:.6;font-size:13px" {{ block.shopify_attributes }}>شارك المنتج</div>
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Main Product",
  "settings": [
    { "type": "checkbox", "id": "enable_sticky_info", "label": "Sticky Info", "default": true },
    { "type": "select", "id": "media_size", "label": "Media Size", "options": [{ "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "large" },
    { "type": "select", "id": "gallery_layout", "label": "Gallery Layout", "options": [{ "value": "thumbnail_slider", "label": "Thumbnails" }, { "value": "stacked", "label": "Stacked" }], "default": "thumbnail_slider" }
  ],
  "blocks": [
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "variant_picker", "name": "Variant Picker", "limit": 1, "settings": [{ "type": "select", "id": "picker_type", "label": "Type", "options": [{ "value": "button", "label": "Buttons" }, { "value": "dropdown", "label": "Dropdown" }], "default": "button" }] },
    { "type": "quantity_selector", "name": "Quantity", "limit": 1 },
    { "type": "buy_buttons", "name": "Buy Buttons", "limit": 1, "settings": [{ "type": "checkbox", "id": "show_dynamic_checkout", "label": "Dynamic Checkout", "default": true }] },
    { "type": "description", "name": "Description", "limit": 1 },
    { "type": "share", "name": "Share", "limit": 1 }
  ]
}
{% endschema %}
