<div class="card">
  <a href="{{ product.url }}" class="card__media">
    {% if product.featured_media %}
      {{ product.featured_media | image_url: width: 400 | image_tag: loading: 'lazy' }}
    {% else %}
      <div style="width:100%;height:100%;background:#1c1c1c;display:grid;place-items:center;color:#444;font-size:12px">No Image</div>
    {% endif %}
    {% if product.compare_at_price > product.price %}
      <span class="card__badge">SALE</span>
    {% elsif product.available == false %}
      <span class="card__badge" style="background:#fff;color:#000">SOLD OUT</span>
    {% endif %}
  </a>
  <div class="card__info">
    <a href="{{ product.url }}" class="card__title">{{ product.title | escape }}</a>
    <div class="card__price">
      <span>{{ product.price | money }}</span>
      {% if product.compare_at_price > product.price %}
        <span class="card__price--compare">{{ product.compare_at_price | money }}</span>
      {% endif %}
    </div>
  </div>
</div>
